# .env.dev.example
# ─────────────────────────────────────────────────────────────────────────────
# Development environment template — safe to commit, contains NO real secrets.
#
# SETUP INSTRUCTIONS (on VM):
#   cp .env.dev.example .env.dev
#   nano .env.dev          # Replace every placeholder value below
#
# NEVER commit .env.dev to Git — it is excluded via .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4001

# ── Database ──────────────────────────────────────────────────────────────────
# IMPORTANT: Must point to the DEVELOPMENT database only.
# The app will refuse to start if DB_NAME is not exactly "uniflow_ops_dev".
# Never set DB_NAME=uniflow_ops here — that is the production database.
DB_HOST=mysql_eco360
DB_PORT=3306
DB_NAME=uniflow_ops_dev
DB_USER=uniflow_ops_dev
DB_PASSWORD=REPLACE_WITH_DEV_DB_PASSWORD

# ── Application Security ──────────────────────────────────────────────────────
# Generate a long random string. Must be different from the production JWT_SECRET.
# Example (Linux): openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_JWT_SECRET_FOR_DEV

# ── Bootstrap Admin Account ───────────────────────────────────────────────────
# Created once on first startup into an empty database.
# Use development-only credentials — do NOT copy production admin password here.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_DEV_ADMIN_PASSWORD

# ── Bootstrap Supervisor Account ─────────────────────────────────────────────
BOOTSTRAP_SUPERVISOR_USERNAME=supervisor
BOOTSTRAP_SUPERVISOR_PASSWORD=REPLACE_WITH_DEV_SUPERVISOR_PASSWORD

# ── Bootstrap Operator Account ────────────────────────────────────────────────
BOOTSTRAP_OPERATOR_USERNAME=operator
BOOTSTRAP_OPERATOR_PASSWORD=REPLACE_WITH_DEV_OPERATOR_PASSWORD

# ── Proxy & Timezone ──────────────────────────────────────────────────────────
TRUST_PROXY=1
FACTORY_TIMEZONE=Asia/Colombo
